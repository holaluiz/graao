# Copy to .env (never commit it). Hosted servers set these as real environment variables.
# Supabase project URL and publishable key: token verification (JWKS) and the record_match RPC.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Match server secret; its SHA-256 must be registered in private.server_keys (see packages/database/migrations).
GRAAO_SERVER_SECRET=
# 1 = refuse players without a valid Supabase token (public servers).
GRAAO_REQUIRE_AUTH=0
