# Copy to .env.local (dev) or set in the host (Cloudflare Pages) for builds.
# Match server WebSocket URL (default: ws://<page host>:2567).
VITE_SERVER_URL=
# Supabase project URL and publishable key (browser-safe). Empty = no cloud profile, everyone is a guest.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
