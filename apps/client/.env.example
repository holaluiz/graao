# Copy to .env.local (dev) or set in the host (Cloudflare Pages) for builds.
# Match server WebSocket URL (default: ws://<page host>:2567).
VITE_SERVER_URL=
# Supabase project URL and publishable key (browser-safe). Empty = no cloud profile, everyone is a guest.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Graao Host (the desktop app that runs a room on the host's PC). Off = rooms are hosted in the creator's browser tab.
# `on` brings back "Criar e hospedar" and the Graao Host rooms in the list (needs the Supabase values above).
VITE_GRAAO_HOST=
