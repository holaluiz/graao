# Copy to .env (never commit .env).

# --- Server (apps/server) ---
PORT=2567
# Allowed browser origin (CORS). In production: the Cloudflare Pages domain.
CLIENT_ORIGIN=http://localhost:5173
# Optional: simulate latency in ms for network testing (dev only).
SIMULATE_LATENCY_MS=0
# Supabase (server-side only). The service role key NEVER goes to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Client (apps/client) ---
# Only VITE_* variables reach the browser. Nothing secret here.
VITE_SERVER_URL=ws://localhost:2567
# Base URL for large versioned assets (R2 custom domain in production; empty = served by the client itself).
VITE_ASSET_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (only for the upload script, never in the client) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=graao-assets
