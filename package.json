{
  "name": "graao",
  "version": "0.1.0",
  "private": true,
  "description": "graao: browser-native stylized 3D multiplayer game on a small spherical world.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @graao/server --filter @graao/client dev",
    "dev:client": "pnpm --filter @graao/client dev",
    "dev:server": "pnpm --filter @graao/server dev",
    "build": "pnpm --filter @graao/client build && pnpm --filter @graao/server build",
    "start": "pnpm --filter @graao/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @graao/client typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets:inspect": "node tools/asset-pipeline/inspect.mjs",
    "assets:anims": "node tools/animation/build-animations.mjs",
    "bot": "tsx tools/networking/bot.ts"
  },
  "devDependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@graao/game-core": "workspace:*",
    "@graao/game-data": "workspace:*",
    "@graao/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
